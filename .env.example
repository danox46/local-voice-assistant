# Optional. Required only for OpenAI cloud voice/transcription modes.
OPENAI_API_KEY=

# Local server/client ports
PORT=8787
VITE_API_BASE_URL=http://127.0.0.1:8787

# Project folder Codex should work in when using Codex CLI mode.
# If omitted, the server defaults to two folders above this app.
# CODEX_WORKDIR=C:\path\to\your\workspace

# Default OpenAI models
ASSISTANT_MODEL=auto
TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
TTS_MODEL=gpt-4o-mini-tts

# Voice settings
TTS_VOICE=marin
SUMMARY_WORDS=45
